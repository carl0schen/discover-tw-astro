<section id="news" class="py-10 md:py-16 bg-white">
  <div class="container mx-auto px-6 max-w-4xl">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">News from Tourism Administration, MOTC</h2>
    </div>
    <div id="rss-news-container" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <p id="news-loading" class="col-span-1 md:col-span-2 text-center text-gray-500 animate-pulse">
        Loading latest news...
      </p>
    </div>
  </div>
</section>

<script>
  async function loadRSS() {
    const container = document.getElementById('rss-news-container');

    try {
      const targetUrl = "https://eng.taiwan.net.tw/rss.aspx?sNo=0002001";
      const feedUrl = encodeURIComponent(targetUrl);
      const apiUrl = `https://api.rss2json.com/v1/api.json?rss_url=${feedUrl}`;

      const response = await fetch(apiUrl);
      const data = await response.json();

      if (data.items && data.items.length > 0) {
        const newsItems = data.items.slice(0, 6);
        container.innerHTML = '';

        newsItems.forEach(item => {
          const dateStr = new Date(item.pubDate).toLocaleDateString();
          const html = `
            <a
              href="${item.link}"
              target="_blank"
              rel="noopener noreferrer"
              class="block p-6 border border-gray-200 rounded-xl bg-gray-50 hover:bg-[#ffe100] transition-all duration-300"
            >
              <h3 class="text-base font-semibold text-gray-900 mb-2">
                ${item.title}
              </h3>
              <p class="text-sm text-gray-500">
                ${dateStr}
              </p>
            </a>
          `;
          container.insertAdjacentHTML('beforeend', html);
        });
      } else {
        throw new Error("Empty RSS data");
      }
    } catch (error) {
      console.error("RSS 擷取失敗:", error);
      container.innerHTML = '<p class="col-span-1 md:col-span-2 text-center text-red-500">目前無法載入最新新聞。</p>';
    }
  }

  document.addEventListener('DOMContentLoaded', loadRSS);
</script>
